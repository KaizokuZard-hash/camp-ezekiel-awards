{
  // Cloudflare Pages project config.
  //
  // The binding MUST be named "DB" — the Functions read `env.DB`. (`wrangler d1 create`
  // suggests `camp_ezekiel_awards`; that name would break the API.)
  //
  // Only `public/` is deployed. Everything else in the repo — README, CLAUDE.md,
  // schema.sql, dev-server.py, this file — stays off the public site. Cloudflare Pages
  // does NOT honour `.assetsignore`, so keeping non-public files out of the output
  // directory is the only reliable way to avoid serving them.
  //
  // `functions/` sits beside `public/` at the repo root and becomes Pages Functions.
  "name": "camp-ezekiel-awards",
  "compatibility_date": "2025-01-01",
  "pages_build_output_dir": "public",

  // THE VOTING SWITCH.
  //   "0" = voting open (normal)
  //   "1" = voting frozen: ballots are refused, results stay visible, the button
  //         reads "Voting Closed"
  // Change the value, commit, push. It auto-deploys in about a minute. Keeping it
  // here rather than in the dashboard means the change is versioned — you can see
  // exactly when voting closed — and it can't hit the "secret set but not deployed"
  // trap, because the value ships as part of the deployment itself.
  "vars": {
    // Manual override. "1" closes voting immediately, whatever the deadline says.
    "VOTING_CLOSED": "0",

    // Automatic deadline. Voting closes the moment this passes — the server checks
    // the clock on every request, so nothing has to be running at that time.
    // ISO-8601 with an explicit offset. -04:00 is US Eastern in summer (EDT);
    // it becomes -05:00 after 1 Nov 2026. Set empty to disable the deadline.
    // 2026-08-16 20:00 Eastern = 2026-08-17 00:00 UTC.
    "VOTING_CLOSES_AT": "2026-08-16T20:00:00-04:00"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camp-ezekiel-awards",
      "database_id": "5e2c37f9-8f03-4d64-857e-43fc4ef0842c"
    }
  ]
}
